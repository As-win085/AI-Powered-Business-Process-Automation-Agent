# ---------------------------------------------------------------------------
# AI-Powered Business Process Automation Agent
# Copy to .env and fill in real values. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME="AI Business Automation"
ENVIRONMENT=development                 # development | test | production
DEBUG=true
API_BASE_PATH=/api
LOG_LEVEL=INFO

# --- Security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-generate-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database (PostgreSQL) -------------------------------------------------
POSTGRES_USER=automation
POSTGRES_PASSWORD=change-me
POSTGRES_DB=automation
POSTGRES_HOST=db
POSTGRES_PORT=5432
# SQLAlchemy async URL example (driver may change with implementation)
DATABASE_URL=postgresql+psycopg://automation:change-me@db:5432/automation

# --- Redis / Celery --------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- File storage (private local storage for development) ------------------
STORAGE_BACKEND=local                   # local | s3 (future)
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.png,.jpg,.jpeg

# --- OCR -------------------------------------------------------------------
OCR_ENGINE=tesseract                    # tesseract | paddleocr (future)
TESSERACT_CMD=
OCR_LANGUAGES=eng

# --- LLM provider (external API behind a provider interface) ---------------
LLM_PROVIDER=mock                       # mock | <provider>
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_REQUESTS_PER_RUN=100

# --- Email / notifications -------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_USE_TLS=true

# --- Frontend (build-time) -------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api
